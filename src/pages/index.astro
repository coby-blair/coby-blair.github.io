---
import SiteLayout from '../layouts/SiteLayout.astro';
import NoteList from '../components/NoteList.astro';
import { publishedNotes } from '../lib/content';
import { pathTo } from '../lib/paths';

const notes = await publishedNotes();
---

<SiteLayout>
  <section class="intro" aria-labelledby="intro-title">
    <p class="eyebrow">A few things worth sharing</p>
    <h1 id="intro-title">Practical notes on<br class="desktop-break" /> AI and software.</h1>
    <p class="intro-copy">I'm Coby. I write about AI, developer tools, and making software work a little better. Clear explanations, useful examples, and things you can try yourself.</p>
    <a class="text-link" href={pathTo('about/')}>A little about me <span aria-hidden="true">&rarr;</span></a>
  </section>

  <section class="featured-series" aria-labelledby="series-title">
    <div class="section-kicker">
      <p class="eyebrow">A short video series</p>
      {!notes.some((note) => note.data.series === 'token-tips') && <span class="status-label">In progress</span>}
    </div>
    <h2 id="series-title"><a href={pathTo('series/token-tips/')}>Two-Minute Token Tips</a></h2>
    <p>Better results from AI, without wasting context, time, or money. One idea, one example, and something useful to take away.</p>
    <a class="text-link" href={pathTo('series/token-tips/')}>About the series <span aria-hidden="true">&rarr;</span></a>
  </section>

  {notes.length > 0 && (
    <section class="recent-notes" aria-labelledby="recent-title">
      <div class="section-heading">
        <h2 id="recent-title">Recent notes</h2>
        <a href={pathTo('notes/')}>All notes <span aria-hidden="true">&rarr;</span></a>
      </div>
      <NoteList notes={notes.slice(0, 4)} />
    </section>
  )}
</SiteLayout>
