---
import SiteLayout from '../layouts/SiteLayout.astro';
import NoteList from '../components/NoteList.astro';
import { publishedNotes } from '../lib/content';
import { pathTo } from '../lib/paths';

const notes = await publishedNotes();
---

<SiteLayout>
  <section class="intro" aria-labelledby="intro-title">
    <p class="eyebrow">A few things worth sharing</p>
    <h1 id="intro-title">Practical notes on<br class="desktop-break" /> AI and software.</h1>
    <p class="intro-copy">I'm Coby. I write about AI, developer tools, and making software work a little better. Clear explanations, useful examples, and things you can try yourself.</p>
    <a class="text-link" href={pathTo('about/')}>A little about me <span aria-hidden="true">&rarr;</span></a>
  </section>

  <section class="content-feed" aria-labelledby="content-title">
    <h2 class="sr-only" id="content-title">Content</h2>
    <NoteList notes={notes} includeTokenTips />
  </section>
</SiteLayout>
