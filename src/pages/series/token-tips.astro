---
import SiteLayout from '../../layouts/SiteLayout.astro';
import NoteList from '../../components/NoteList.astro';
import TokenTipsRoadmap from '../../components/TokenTipsRoadmap.astro';
import { publishedNotes } from '../../lib/content';
import { resolveTokenTipsRoadmap } from '../../lib/token-tips';

const notes = (await publishedNotes())
  .filter((note) => note.data.series === 'token-tips')
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));
const mappedSlugs = new Set(resolveTokenTipsRoadmap(notes)
  .flatMap((chapter) => chapter.checkpoints.flatMap(({ note }) => note ? [note.data.slug] : [])));
const additionalNotes = notes.filter((note) => !mappedSlugs.has(note.data.slug));
---

<SiteLayout title="Two-Minute Token Tips" description="A roadmap of short videos on GitHub Copilot: clearer tasks, useful context, model choice, and measuring results." section="notes">
  <div class="page-heading">
    <p class="eyebrow">A short video series</p>
    <h1>Two-Minute<br class="desktop-break" /> Token Tips.</h1>
    <p class="lede">Practical ways to get more out of GitHub Copilot. One idea at a time.</p>
  </div>
  <div class="prose series-intro">
    <p>Follow the path or jump to a topic. Each episode will pair a short YouTube video with an example, a transcript, and references. Planned topics are listed below.</p>
    <p><a href="https://www.youtube.com/playlist?list=PLUiG6TzZ9a2k">Watch the playlist on YouTube</a>.</p>
  </div>
  <TokenTipsRoadmap notes={notes} />
  {additionalNotes.length > 0 && (
    <section class="additional-episodes" aria-labelledby="additional-title">
      <h2 id="additional-title">More from the series</h2>
      <NoteList notes={additionalNotes} />
    </section>
  )}
</SiteLayout>
