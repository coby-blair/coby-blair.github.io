---
import SiteLayout from '../../layouts/SiteLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { publishedNotes } from '../../lib/content';
import { pathTo } from '../../lib/paths';
const notes = await publishedNotes();
---

<SiteLayout title="Notes" description="Short explanations, examples, and practical notes on AI and software." section="notes">
  <div class="page-heading">
    <h1>Notes.</h1>
    <p class="lede">Short explanations, videos, and few things worth trying out.</p>
  </div>
  {notes.length > 0 ? <NoteList notes={notes} /> : (
    <div class="empty-state prose">
      <h2><a href={pathTo('series/token-tips/')}>Two-Minute Token Tips</a></h2>
      <h3>Do more and spend less with GitHub Copilot</h3>
      <p>Short, practical videos and mini-lessons on clearer tasks, better context, and getting useful results from GitHub Copilot.</p>
    </div>
  )}
</SiteLayout>
