---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pathTo } from '../lib/paths';
---

<SiteLayout title="Page not found" noindex>
  <div class="page-heading">
    <p class="eyebrow">404</p>
    <h1>Nothing here.</h1>
    <p class="lede">This link may have changed, or the page may not exist yet.</p>
    <a class="text-link" href={pathTo()}>Back to the start <span aria-hidden="true">&rarr;</span></a>
  </div>
</SiteLayout>
