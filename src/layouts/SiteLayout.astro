---
import '../styles/global.css';
import { pathTo, absoluteUrl } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  section?: 'notes' | 'about';
  noindex?: boolean;
}

const {
  title,
  description = 'Practical notes on AI, developer tools, and building software. By Coby Blair.',
  section,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} - Coby Blair` : 'Coby Blair - Practical notes on AI and software';
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const local = site.hostname === 'localhost' || site.hostname === '127.0.0.1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const param = new URLSearchParams(window.location.search).get('scoutTheme');
        const theme = param === 'dark' || param === 'light'
          ? param
          : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {(noindex || local) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Coby Blair - Notes" href={pathTo('rss.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl('social.png', site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coby Blair. Practical notes on AI and software." />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-name" href={pathTo()}>Coby Blair<span class="name-dot" aria-hidden="true">.</span></a>
        <nav aria-label="Main navigation">
          <a href={pathTo('notes/')} aria-current={section === 'notes' ? 'page' : undefined}>Notes</a>
          <a href={pathTo('about/')} aria-current={section === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <p>A personal site. Views are my own.</p>
        <a href={pathTo('rss.xml')}>RSS<span class="sr-only"> feed</span></a>
      </footer>
    </div>
  </body>
</html>
